# ── Ordre environment variables ─────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored and must never be committed.

# Required. Anthropic API key used by the curator + profile-summary routes.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required. Supabase project credentials.
# Project Settings → API in the Supabase dashboard.
# Use the classic JWT anon key (eyJ...) — the new sb_publishable_ format is
# not yet supported by @supabase/supabase-js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended for production. The canonical, absolute base URL of the deployed
# site (no trailing slash). Used for Open Graph / Twitter card image URLs,
# robots.txt, and the sitemap. Falls back to http://localhost:3000 in dev.
# Example: https://ordre.com
NEXT_PUBLIC_SITE_URL=
